  "defaultLevel": "beginner",
  "lesson": {
    "beginner": {
      "summary": {
        "en": "This is the theme of Ode to Joy, 16 bars. The right hand plays the tune in C major, which uses only white keys and starts with the thumb on C. The left hand adds one long note in each bar, C or G.",
        "es": "Este es el tema de la Oda a la alegría, 16 compases. La mano derecha toca la melodía en Do mayor, que usa solo teclas blancas y empieza con el pulgar en Do. La mano izquierda agrega una nota larga en cada compás, Do o Sol."
      },
      "chordsUsed": [
        "C",
        "G"
      ],
      "handPositions": [
        {
          "tick": 0,
          "hand": "R",
          "anchor": "D4",
          "text": "Put the thumb (1) on D4 and rest one finger on each of the next four white keys. The first note is E, played with finger 2."
        },
        {
          "tick": 0,
          "hand": "L",
          "anchor": "C3",
          "text": "Little finger (5) on C3. It plays one whole note in the bar."
        },
        {
          "tick": 5760,
          "hand": "L",
          "anchor": "G2",
          "text": "Bar 4: the left hand goes down to G2 for one bar, then comes back to C3."
        },
        {
          "tick": 22080,
          "hand": "R",
          "anchor": "G3",
          "text": "Bar 12: the last note jumps down to G3. Move the right hand there, then come back to C4 for the final bars."
        }
      ],
      "posture": {
        "en": "Sit tall, with your elbows level with the keys and your fingers curved. Let your arms hang loose.",
        "es": "Siéntese derecho, con los codos a la altura de las teclas y los dedos curvos. Deje los brazos sueltos."
      },
      "practicePlan": [
        "Learn one phrase at a time: the right hand slowly, then the left hand, then both hands.",
        "Play each phrase until it feels easy, then go to the next one.",
        "When all eight phrases are easy, play the whole song at the song speed."
      ],
      "arrangementNote": "The right hand is the soprano line of the source, moved from G major down a fifth to C major and written in the register C4 to G4 (one note, bar 12, goes down to G3). The left hand is NOT in the source: it is an editorial arrangement of one whole note per bar, C or G, written for this project."
    }
  },
